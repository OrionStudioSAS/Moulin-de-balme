# ── Back-office (sans base de données) ─────────────────────────────────────
# Le contenu (produits, catégories, recettes, réglages, images) vit dans contenu/
# de ce dépôt ; les commandes, qui contiennent des données personnelles, dans un
# dépôt privé à part. L'admin écrit par commits via l'API GitHub.

# Jeton GitHub « fine-grained » : Contents en lecture/écriture sur les DEUX dépôts.
# En local, à défaut, `gh auth token` est utilisé.
GITHUB_TOKEN=

# Facultatifs (valeurs par défaut ci-dessous)
# GITHUB_DEPOT=OrionStudioSAS/Moulin-de-balme
# GITHUB_DEPOT_COMMANDES=OrionStudioSAS/moulin-de-balme-commandes
# GITHUB_BRANCHE=main

# Comptes de l'admin, séparés par des virgules. Générer une entrée avec :
#   node scripts/creer-compte-admin.mjs
ADMIN_COMPTES=

# Clé de signature des sessions (32 caractères minimum), par exemple :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_SECRET_SESSION=

# ── E-mails de commande ────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=
NOTIFICATION_EMAIL=
